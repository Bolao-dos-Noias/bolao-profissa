# Sessao, CSRF e cookies. Troque em qualquer ambiente compartilhado.
SECRET_KEY=change-me-in-production-32-bytes-random

# Banco local SQLite. Producao tambem aceita Turso/libsql.
DATABASE_URL=sqlite:///./data/bolao.db
# DATABASE_URL=sqlite+libsql://your-db.turso.io/?authToken=eyJ...&secure=true

# Token para rotas administrativas chamadas por cron.
ADMIN_TOKEN=change-me-random-string
CRON_SECRET=

# Senha inicial do usuario admin criado no boot.
ADMIN_PASSWORD=change-me-admin-password

# Deadline UTC do fechamento geral de palpites.
BOLAO_DEADLINE_UTC=2026-06-11T19:00:00Z

# API externa. ESPN nao precisa de chave; football-data fica reservado para fallback.
FOOTBALL_DATA_API_KEY=

# dev | prod | test
APP_ENV=dev

